//@version=6
indicator("PropTrader AI v17.1 — Colector M5–H4", shorttitle="PTAI M5-H4", overlay=true)

// Se aplică o singură dată pe graficul M5.
// Fiecare lumânare M5 închisă ajunge la server, care construiește automat
// M15, M30, H1 și H4 și analizează separat toate cele cinci intervale.
// Alerta trebuie configurată numai cu Webhook URL; toate celelalte
// notificări TradingView trebuie debifate.

groupConnection = "Conectare"
sendBars = input.bool(true, "Trimite lumânările M5 la server", group=groupConnection)
showStatus = input.bool(true, "Arată starea pe grafic", group=groupConnection)

isM5 = timeframe.isminutes and timeframe.multiplier == 5
collectorReady = isM5 and sendBars
collectorEvent = collectorReady and barstate.isconfirmed

var table statusTable = table.new(position.top_right, 1, 3)
if showStatus and barstate.islast
    table.cell(statusTable, 0, 0, "PropTrader AI v17.1")
    table.cell(statusTable, 0, 1, collectorReady ? "Webhook M5 ACTIV" : "Schimbă graficul pe M5")
    table.cell(statusTable, 0, 2, "Server: M5 · M15 · M30 · H1 · H4")

plotshape(
     collectorEvent,
     title="BAR M5 trimis",
     style=shape.circle,
     location=location.bottom,
     size=size.tiny,
     color=color.new(color.blue, 75)
)

alertcondition(
     collectorEvent,
     title="Colector M5 — webhook fără notificări",
     message="{\"event\":\"BAR\",\"external_id\":\"TV-{{ticker}}-5-{{time}}\",\"bar_time\":\"{{time}}\",\"symbol\":\"{{ticker}}\",\"timeframe\":\"5\",\"open\":{{open}},\"high\":{{high}},\"low\":{{low}},\"close\":{{close}},\"volume\":{{volume}}}"
)
